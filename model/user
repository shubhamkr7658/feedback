const mongoose = require('mongoose');

const userSchema = new mongoose.Schema({
    name: {
        type: String,
        required: true
    },
    gmail: {
        type: String,
        required: true,
        unique: true
    },
    rating: {
        type: Number,
        required: true
    },
    feedback: {
        type: String,
        maxlength: 20
    }
});

module.exports = mongoose.model('User', userSchema);