<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Feedback Form</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;

            /* Pleasant blue-purple background */
            background:
                radial-gradient(circle at 10% 20%, rgba(92, 141, 255, 0.25), transparent 30%),
                radial-gradient(circle at 90% 80%, rgba(168, 85, 247, 0.22), transparent 30%),
                linear-gradient(135deg, #101827, #172554, #312e81);

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 30px 15px;
            color: #e5e7eb;
        }

        /* Decorative circles */
        body::before,
        body::after {
            content: "";
            position: fixed;
            border-radius: 50%;
            filter: blur(2px);
            z-index: -1;
        }

        body::before {
            width: 220px;
            height: 220px;
            background: rgba(59, 130, 246, 0.18);
            top: -70px;
            left: -70px;
        }

        body::after {
            width: 280px;
            height: 280px;
            background: rgba(139, 92, 246, 0.16);
            bottom: -100px;
            right: -80px;
        }

        /* Main card */
        .feedback-card {
            width: 100%;
            max-width: 560px;

            padding: 38px;

            background: rgba(30, 41, 59, 0.82);
            border: 1px solid rgba(148, 163, 184, 0.18);

            border-radius: 24px;

            box-shadow:
                0 25px 60px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.05);

            backdrop-filter: blur(18px);

            animation: cardAppear 0.7s ease;
        }

        @keyframes cardAppear {
            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Header */
        .header {
            text-align: center;
            margin-bottom: 32px;
        }

        .icon {
            width: 70px;
            height: 70px;

            margin: 0 auto 18px;

            display: flex;
            justify-content: center;
            align-items: center;

            border-radius: 20px;

            background: linear-gradient(
                135deg,
                #3b82f6,
                #8b5cf6
            );

            font-size: 32px;

            box-shadow:
                0 12px 30px rgba(59, 130, 246, 0.3);

            transform: rotate(-5deg);
        }

        .header h2 {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 10px;

            background: linear-gradient(
                90deg,
                #60a5fa,
                #a78bfa
            );

            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header p {
            color: #94a3b8;
            font-size: 15px;
            line-height: 1.6;
        }

        /* Form */
        .form-group {
            margin-bottom: 22px;
        }

        label {
            display: block;
            margin-bottom: 9px;

            color: #dbeafe;
            font-size: 14px;
            font-weight: 600;
        }

        /* Inputs */
        input[type="text"],
        input[type="email"],
        textarea {
            width: 100%;

            padding: 14px 16px;

            background: rgba(15, 23, 42, 0.75);

            border: 1px solid #334155;

            border-radius: 12px;

            color: #f1f5f9;

            font-size: 15px;

            outline: none;

            transition: all 0.25s ease;
        }

        input::placeholder,
        textarea::placeholder {
            color: #64748b;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        textarea:focus {
            border-color: #60a5fa;

            box-shadow:
                0 0 0 3px rgba(96, 165, 250, 0.12);

            background: rgba(15, 23, 42, 0.95);

            transform: translateY(-1px);
        }

        textarea {
            min-height: 120px;
            resize: vertical;
            line-height: 1.5;
        }

        /* Rating */
        .rating-group {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 10px;

            margin-top: 10px;
        }

        .rating-option {
            position: relative;
        }

        /* Hide actual radio button */
        .rating-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .rating-option label {
            margin: 0;

            height: 70px;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            gap: 4px;

            background: rgba(15, 23, 42, 0.7);

            border: 1px solid #334155;

            border-radius: 14px;

            cursor: pointer;

            color: #94a3b8;

            font-size: 14px;

            transition: all 0.25s ease;
        }

        /* Star */
        .rating-option label::before {
            content: "★";

            font-size: 22px;

            color: #64748b;

            transition: all 0.25s ease;
        }

        .rating-option label:hover {
            border-color: #60a5fa;

            transform: translateY(-4px);

            background: rgba(30, 64, 175, 0.25);
        }

        .rating-option label:hover::before {
            color: #fbbf24;
        }

        /* Selected rating */
        .rating-option input:checked + label {
            border-color: #60a5fa;

            background:
                linear-gradient(
                    145deg,
                    rgba(37, 99, 235, 0.3),
                    rgba(124, 58, 237, 0.3)
                );

            color: #e0f2fe;

            box-shadow:
                0 8px 20px rgba(59, 130, 246, 0.15);

            transform: translateY(-3px);
        }

        .rating-option input:checked + label::before {
            color: #fbbf24;

            transform: scale(1.15);
        }

        /* Submit button */
        button {
            width: 100%;

            margin-top: 5px;

            padding: 15px;

            border: none;
            border-radius: 13px;

            background:
                linear-gradient(
                    100deg,
                    #2563eb,
                    #7c3aed
                );

            color: white;

            font-size: 16px;
            font-weight: 700;

            cursor: pointer;

            box-shadow:
                0 10px 25px rgba(79, 70, 229, 0.3);

            transition: all 0.25s ease;
        }

        button:hover {
            transform: translateY(-3px);

            box-shadow:
                0 15px 30px rgba(79, 70, 229, 0.42);

            background:
                linear-gradient(
                    100deg,
                    #3b82f6,
                    #8b5cf6
                );
        }

        button:active {
            transform: translateY(0);
        }

        /* Bottom text */
        .footer-text {
            text-align: center;

            margin-top: 20px;

            color: #64748b;

            font-size: 13px;
        }

        /* Mobile */
        @media (max-width: 600px) {

            body {
                padding: 15px;
            }

            .feedback-card {
                padding: 25px 20px;
                border-radius: 20px;
            }

            .header h2 {
                font-size: 25px;
            }

            .rating-group {
                gap: 6px;
            }

            .rating-option label {
                height: 62px;
            }

            .rating-option label::before {
                font-size: 19px;
            }
        }

        @media (max-width: 380px) {

            .rating-option label {
                height: 55px;
                font-size: 12px;
            }

            .rating-option label::before {
                font-size: 17px;
            }
        }
    </style>
</head>

<body>

    <div class="feedback-card">

        <div class="header">

            <div class="icon">
                💬
            </div>

            <h2>We Value Your Feedback</h2>

            <p>
                Your feedback helps us improve our service
                and create a better experience for everyone.
            </p>

        </div>


        <!-- IMPORTANT: Backend route unchanged -->
        <form action="/feedback" method="POST">

            <!-- NAME -->
            <div class="form-group">

                <label for="name">
                    Full Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your name"
                    required
                >

            </div>


            <!-- EMAIL -->
            <div class="form-group">

                <label for="email">
                    Email Address
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    required
                >

            </div>


            <!-- RATING -->
            <div class="form-group">

                <label>
                    Overall Experience
                </label>

                <div class="rating-group">

                    <div class="rating-option">
                        <input
                            type="radio"
                            id="star1"
                            name="rating"
                            value="1"
                            required
                        >
                        <label for="star1">1</label>
                    </div>

                    <div class="rating-option">
                        <input
                            type="radio"
                            id="star2"
                            name="rating"
                            value="2"
                        >
                        <label for="star2">2</label>
                    </div>

                    <div class="rating-option">
                        <input
                            type="radio"
                            id="star3"
                            name="rating"
                            value="3"
                        >
                        <label for="star3">3</label>
                    </div>

                    <div class="rating-option">
                        <input
                            type="radio"
                            id="star4"
                            name="rating"
                            value="4"
                        >
                        <label for="star4">4</label>
                    </div>

                    <div class="rating-option">
                        <input
                            type="radio"
                            id="star5"
                            name="rating"
                            value="5"
                        >
                        <label for="star5">5</label>
                    </div>

                </div>

            </div>


            <!-- COMMENTS -->
            <div class="form-group">

                <label for="comments">
                    Your Comments
                </label>

                <textarea
                    id="comments"
                    name="comments"
                    placeholder="Tell us more about your experience..."
                ></textarea>

            </div>


            <!-- SUBMIT -->
            <button type="submit">
                Submit Feedback →
            </button>

        </form>


        <div class="footer-text">
            ✦ Thank you for taking the time to share your thoughts ✦
        </div>

    </div>

</body>
</html>
